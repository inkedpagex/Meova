rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Helper: checks if user is an admin in the users collection
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: checks if resource belongs to owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if isOwner(uid) || isAdmin();

      // Notifications Sub-Collection
      match /notifications/{notifId} {
        // User can read and mark their own notifications as read
        allow read, update: if isOwner(uid);
        // Server (admin) can create notifications for anyone
        allow create: if request.auth != null;
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // Wallets Collection (Only server/functions modify balances)
    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false; // Block client-side edits
    }

    // Transactions Collection (Immutable ledger, only server/functions write)
    match /transactions/{txId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false; // Block client-side edits
    }

    // Withdrawals Collection (Users request, admin updates)
    match /withdrawals/{wdId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Payment Requests Collection (Users request, admin updates)
    match /payment_requests/{payId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Audit Logs (Only admins read/write)
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Circles Collection
    match /circles/{circleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Chats Collection — only participants can read/write
    match /chats/{chatId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participants;
      // Only server (Admin SDK) creates chats — client cannot create
      allow create: if false;
      // Participants can update lastMessage, unreadCount etc.
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participants;
      allow delete: if false;

      // Messages sub-collection
      match /messages/{msgId} {
        // Only participants can read messages
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(db)/documents/chats/$(chatId)).data.participants;
        // Participants can send messages (but only as themselves)
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(db)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
