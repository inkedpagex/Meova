rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Helper: checks if user is an admin in the users collection
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: checks if resource belongs to owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if isOwner(uid) || isAdmin();
    }

    // Wallets Collection (Only server/functions modify balances)
    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false; // Block client-side edits
    }

    // Transactions Collection (Immutable ledger, only server/functions write)
    match /transactions/{txId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false; // Block client-side edits
    }

    // Withdrawals Collection (Users request, admin updates)
    match /withdrawals/{wdId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Payment Requests Collection (Users request, admin updates)
    match /payment_requests/{payId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Audit Logs (Only admins read/write)
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Circles Collection
    match /circles/{circleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
